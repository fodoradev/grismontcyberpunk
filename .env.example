# Postgres connection string (Neon EU in production; local Postgres in development)
DATABASE_URL=postgres://localhost:5432/grismont_scorecard
# Public base URL used in email links. In production: https://grismont.hu
APP_URL=http://127.0.0.1:3100
# Resend API key. Leave empty in development: emails are written to .outbox/ instead.
RESEND_API_KEY=
# Sender on a domain verified in Resend (SPF/DKIM)
EMAIL_FROM="Grismont <hello@grismont.hu>"
# Receives a notification for every completed scorecard; also the reply-to of report emails
OWNER_NOTIFY_EMAIL=hello@grismont.hu
# Shared secret for the daily cron (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
# Salt for hashing IP addresses used in rate limiting
IP_HASH_SALT=
# Max scorecard starts per IP per hour (default 5). Raise it locally so repeated e2e runs are not blocked.
SCORECARD_INTAKES_PER_HOUR=
